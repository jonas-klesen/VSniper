# App runtime
APP_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web
WEB_PORT=5173
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Storage
SQLITE_PATH=storage/sqlite/vsniper.db
UPLOAD_DIR=storage/uploads
CACHE_DIR=storage/cache

# Vinted
VINTED_REGION=de
VINTED_COOKIE=put-your-vinted-cookie-here
# Add-by-URL imports use a persistent visible Chromium session. Use a sticky
# residential proxy so manually solved Cloudflare clearance keeps the same IP.
VINTED_BROWSER_WEBDRIVER_URL=http://browser:4444/wd/hub
VINTED_BROWSER_PROXY_URL=
VINTED_BROWSER_TIMEOUT_SECONDS=30
VINTED_BROWSER_PROFILE_DIR=/app/browser-profile

# Telegram
TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token-here
TELEGRAM_CHAT_ID=put-your-telegram-chat-id-here
TELEGRAM_WEBHOOK_URL=put-your-telegram-webhook-url-here
TELEGRAM_WEBHOOK_SECRET=put-your-telegram-webhook-secret-here

# AI judging and learning
# AI_JUDGE_PROVIDER=local uses LOCAL_VLM_BASE_URL for judging. AI_JUDGE_PROVIDER=openai uses OpenAI directly.
# AI_JUDGE_FALLBACK_PROVIDER controls retry behavior for failed local judge calls: none, openai, or cerebras.
# Local judging always calls POST /v1/responses and expects llama.cpp-compatible top-level json_schema support.
AI_JUDGE_PROVIDER=local
AI_JUDGE_MODEL=gpt-5.4-mini
LOCAL_JUDGE_MODEL=gemma4-12b-quality
AI_JUDGE_ALLOW_OPENAI_FALLBACK=false
AI_JUDGE_FALLBACK_PROVIDER=none
CEREBRAS_API_KEY=put-your-cerebras-api-key-here
CEREBRAS_API_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_JUDGE_MODEL=gemma-4-31b
OPENROUTER_API_KEY=put-your-openrouter-api-key-here
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
AI_JUDGE_REASONING_EFFORT=low
AI_JUDGE_IMAGE_DETAIL=low
LOCAL_VLM_BASE_URL=http://host.docker.internal:8080/v1
AI_LEARN_MODEL=gpt-5.5
AI_LEARN_REASONING_EFFORT=medium
AI_LEARN_IMAGE_DETAIL=low
AI_LEARN_OBSERVATION_BATCH_SIZE=15
AI_API_KEY=put-your-ai-key-here

# Scan judging
VLM_GRID_SIZE=1
VLM_PACK_MULTIPLE_LISTING_IMAGES=true

# Worker
WORKER_MAX_CONCURRENCY=4
# Seed/fallback only — once the app has run once, edit the scan interval on the Settings
# page instead; that value (stored in the DB) is what the worker actually polls each cycle.
SCAN_INTERVAL_SECONDS=1800
# Retention: the worker prunes rows older than these windows (in days). Generous by default;
# pending/processing Telegram deliveries are never pruned regardless of age.
CANDIDATE_RETENTION_DAYS=365
DELIVERY_RETENTION_DAYS=365
AI_USAGE_RETENTION_DAYS=365
# How often (in maintenance passes) the prune job runs. Maintenance runs on its own fixed
# ~60s cadence independent of the scan interval, so 60 cycles is still ~hourly.
PRUNE_EVERY_CYCLES=60

# API
# Comma-separated browser origins allowed to call the API (CORS). Defaults to the local Vite
# dev server. In a LAN/deployed setup, set this to the exact host(s) you serve the web app from.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gateway and reverse proxy
APP_PORT=80
# Basic Auth Users format: username:{SHA}base64(sha1(password))
# Run: python3 scripts/generate_auth.py to create custom secure credentials.
# CHANGE THIS before deploying. Default below is admin / admin.
BASIC_AUTH_USERS=admin:{SHA}0DPiKuNIrrVmD8IUCuw1hQxNqZc=
